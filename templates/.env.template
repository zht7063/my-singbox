SING_BOX_VERSION=<sing-box-version>

# VLESS
VLESS_UUID=<generated-uuid>

# REALITY
REALITY_PRIVATE_KEY=<generated-private-key>
REALITY_PUBLIC_KEY=<generated-public-key>
REALITY_SHORT_ID=<generated-short-id>

# Shadowsocks 2022
SS_PASSWORD=<generated-ss-key>

# Client
SERVER_ADDRESS=<server-address>

# Listening ports (optional; omit to use 8388/8443)
# Decimal integers from 1 to 65535; the two ports must be different.
# SS_PORT=8388
# VLESS_PORT=8443

# ISP outbound
# Optional; managed by my-singbox isp-outbound --add / --remove.
# TypeScript uses config.json to route selected domains through ISP SOCKS5;
# without ISP, optional ISP rules are omitted and the final outbound is direct.
# Both modes keep two base inbounds/client nodes; no extra ISP listening ports.
# Clash rules, rule providers, and DNS are unchanged; ISP commands never edit Clash.
# The server domain list lives in templates/config.json.template.
# The legacy scripts/isp-outbound.sh retains its extra-port/client-node workflow.
# Stored as plain text; the username and password are wrapped in double quotes
# (inside them: \\ for a backslash, \" for a quote, $$ for a dollar sign).
# ISP_SOCKS_ADDR=
# ISP_SOCKS_USER=
# ISP_SOCKS_PASS=
# ISP_SOCKS_EGRESS_IP=
